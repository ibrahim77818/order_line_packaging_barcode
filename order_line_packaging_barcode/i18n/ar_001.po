msgid "Scan or type a packaging / product barcode, then press Enter"
msgstr "امسح أو اكتب باركود التعبئة / المنتج ثم اضغط Enter"

#. module: order_line_packaging_barcode
#: model:ir.model.fields,help:order_line_packaging_barcode.field_packaging_barcode_order_mixin__packaging_barcode_input
