#: model:ir.model.fields,help:order_line_packaging_barcode.field_sale_order__packaging_barcode_input
msgid "Scan or type a packaging or product barcode and press Enter. Scanning the same barcode again increases the matching line."
msgstr "امسح أو اكتب باركود تعبئة أو منتج ثم اضغط Enter. مسح الباركود نفسه مرة أخرى يزيد كمية البند المطابق."

#. module: order_line_packaging_barcode
#: model:ir.model.fields,help:order_line_packaging_barcode.field_packaging_barcode_line_mixin__packaging_barcode_input
#: model:ir.model.fields,help:order_line_packaging_barcode.field_purchase_order_line__packaging_barcode_input
#: model:ir.model.fields,help:order_line_packaging_barcode.field_sale_order_line__packaging_barcode_input
msgid "Scan or type a packaging or product barcode to fill this line. Scanning the line's own barcode again adds one more unit or package."
msgstr "امسح أو اكتب باركود تعبئة أو منتج لملء هذا البند. مسح باركود البند نفسه مرة أخرى يضيف وحدة أو عبوة إضافية."

#. module: order_line_packaging_barcode
#: model_terms:ir.ui.view,arch_db:order_line_packaging_barcode.res_config_settings_view_form_purchase_olpb
msgid "Scan packaging and product barcodes on purchase order lines."
msgstr "مسح باركود التعبئة والمنتجات في بنود أوامر الشراء."

#. module: order_line_packaging_barcode
#: model_terms:ir.ui.view,arch_db:order_line_packaging_barcode.res_config_settings_view_form_sale_olpb
