<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_sale_olpb" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sale.packaging.barcode</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@data-key='sale_management']//div[@id='stock_packaging']" position="after">
                <div class="col-12 col-lg-6 o_setting_box" id="sale_packaging_barcode_scan_setting"
                     title="Scan packaging and product barcodes on sales order lines.">
                    <div class="o_setting_left_pane">
                        <field name="sale_packaging_barcode_scan"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="sale_packaging_barcode_scan" string="Packaging Barcode Scanning"/>
                        <div class="text-muted">
                            Scan barcodes on sales orders: a packaging barcode adds the packaging quantity, a product barcode adds one unit
                        </div>
                        <div class="text-warning mt8 o_olpb_setting_hint" attrs="{'invisible': ['|', ('sale_packaging_barcode_scan', '=', False), ('group_stock_packaging', '=', True)]}">
                            Enable Product Packagings to see the packaging on order lines. Product barcodes work either way.
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="res_config_settings_view_form_purchase_olpb" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.purchase.packaging.barcode</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@data-key='purchase']//div[@id='stock_packaging_purchase']" position="after">
                <div class="col-12 col-lg-6 o_setting_box" id="purchase_packaging_barcode_scan_setting"
                     title="Scan packaging and product barcodes on purchase order lines.">
                    <div class="o_setting_left_pane">
                        <field name="purchase_packaging_barcode_scan"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="purchase_packaging_barcode_scan" string="Packaging Barcode Scanning"/>
                        <div class="text-muted">
                            Scan barcodes on requests for quotation: a packaging barcode adds the packaging quantity, a product barcode adds one unit
                        </div>
                        <div class="text-warning mt8 o_olpb_setting_hint" attrs="{'invisible': ['|', ('purchase_packaging_barcode_scan', '=', False), ('group_stock_packaging', '=', True)]}">
                            Enable Product Packagings to see the packaging on order lines. Product barcodes work either way.
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
